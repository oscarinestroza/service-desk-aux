# Django
SECRET_KEY=tu-secret-key-aqui-genera-una-nueva-con-django-admin
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (Postgres obligatorio — docker-compose.yml levanta uno local)
#   postgresql://enlacesmao:enlacesmao@localhost:5432/enlacesmao
# Usa este formato: postgres:// o postgresql:// (name es lo importante)
DATABASE_URL=postgresql://enlacesmao:enlacesmao@localhost:5432/enlacesmao
# Alternativa por campos individuales (usa solo si no pones DATABASE_URL):
# DB_NAME=enlacesmao
# DB_USER=enlacesmao
# DB_PASSWORD=enlacesmao
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=0

# Redis / Celery (cola de tareas en segundo plano)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Límite de tiempo por tarea SIG (segundos)
CELERY_TASK_TIME_LIMIT=300