# Django
SECRET_KEY=tu-secret-key-aqui-genera-una-nueva-con-django-admin
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# true: el correo de notificación va al correo_principal del enlace + lista configurada.
# false: solo a la lista correo_notificacion (modo prueba, sin exponer secretos con DEBUG).
MAIL_NOTIFICAR_USUARIO=true

# Base de datos (Postgres obligatorio — docker-compose.yml levanta uno local)
#   postgresql://enlacesmao:enlacesmao@localhost:5432/enlacesmao
# Usa este formato: postgres:// o postgresql:// (name es lo importante)
DATABASE_URL=postgresql://enlacesmao:enlacesmao@localhost:5432/enlacesmao
# Alternativa por campos individuales (usa solo si no pones DATABASE_URL):
# DB_NAME=enlacesmao
# DB_USER=enlacesmao
# DB_PASSWORD=enlacesmao
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=0

# Redis / Celery (cola de tareas en segundo plano)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Límite de tiempo por tarea SIG (segundos)
CELERY_TASK_TIME_LIMIT=300

# Workers Celery (2 colas: no-programadas = enlaces, programadas = tickets)
#   worker 1 (enlaces):  sin extras, consume no-programadas (default).
#   worker 2 (tickets):  CELERY_QUEUES=programadas y CELERY_BEAT=1 (solo en ese worker).
# CELERY_QUEUES=no-programadas
# CELERY_BEAT=0

# Cuenta SIG del worker de tickets (sin valor por ahora: se llena en Fase 1)
# SIG_TICKETS_URL=
# SIG_TICKETS_USUARIO=
# SIG_TICKETS_PASSWORD=