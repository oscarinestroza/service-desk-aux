# Django
SECRET_KEY=tu-secret-key-aqui-genera-una-nueva-con-django-admin
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (SQLite por defecto; para Postgres usa DATABASE_URL)
# DATABASE_URL=postgres://user:pass@localhost:5432/enlacesmao

# SIG (sistema externo - credenciales para el login automatizado con Playwright)
SIG_URL=https://sig.gia.mx/webapp/
SIG_USER=tu-usuario-del-sig
SIG_PASSWORD=tu-contrasena-del-sig
SIG_TIMEOUT=30
# Contrasena por defecto que se asigna a los usuarios SIG al crearlos
SIG_DEFAULT_PASSWORD=cambiar-contrasena
    
# Email (opcional, si usas notificaciones)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu@email.com
EMAIL_HOST_PASSWORD=tu-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Enlaces CCG <no-reply@localhost>

# Otras (ajusta según necesidad)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0