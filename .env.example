# Django
SECRET_KEY=tu-secret-key-aqui-genera-una-nueva-con-django-admin
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
# Si no defines DB_* (o DATABASE_URL) se usa SQLite (desarrollo conveniente).
# Con docker compose local:
#   postgresql://enlacesmao:enlacesmao@localhost:5432/enlacesmao
# Usa este formato: postgres:// o postgresql:// (name es lo importante)
DATABASE_URL=postgresql://enlacesmao:enlacesmao@localhost:5432/enlacesmao
# Alternativa por campos individuales (usa solo si no pones DATABASE_URL):
# DB_NAME=enlacesmao
# DB_USER=enlacesmao
# DB_PASSWORD=enlacesmao
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=0

# Redis / Celery (cola de tareas en segundo plano)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Límite de tiempo por tarea SIG (segundos)
CELERY_TASK_TIME_LIMIT=300

# SIG (sistema externo - credenciales para el login automatizado con Playwright)
SIG_URL=https://sig.gia.mx/webapp/
SIG_USER=tu-usuario-del-sig
SIG_PASSWORD=tu-contrasena-del-sig
SIG_TIMEOUT=30
# Contrasena por defecto que se asigna a los usuarios SIG al crearlos
SIG_DEFAULT_PASSWORD=cambiar-contrasena

# Email (opcional, si usas notificaciones)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu@email.com
EMAIL_HOST_PASSWORD=tu-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Enlaces CCG <no-reply@localhost>